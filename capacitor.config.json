{
  "appId": "com.alertaurbana.reportes",
  "appName": "AlertaUrbana",
  "webDir": "www",
  "bundledWebRuntime": false,
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Geolocation": {
      "permissions": ["location", "coarseLocation"]
    },
    "Camera": {
      "permissions": ["camera", "photos"]
    }
  }
}
